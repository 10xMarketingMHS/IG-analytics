# Supabase Postgres connection (used purely as a database — no Supabase
# Auth/RLS/Realtime). Get this from Supabase → Settings → Database.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Single admin credential — the entire auth model for this app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USER_ID=

# Signs the session JWT. Generate with: openssl rand -hex 32
JWT_SECRET=

PORT=4000
# Origin allowed to call this API with credentials (the Vite dev server).
CORS_ORIGIN=http://localhost:3000

# --- Integrations (optional; Instagram live sync stays off until all four are set) ---
# See docs/instagram-sync-setup.md for the full walkthrough.
# Public origin of this deployment (no trailing slash, no /api). Dev: http://localhost:4000
APP_BASE_URL=
# 32-byte key that encrypts stored access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# Meta (Facebook/Instagram) app — developers.facebook.com → your app → Settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Simplest path: a long-lived Meta System User token (Business Settings → System
# users → Generate token, expiry "Never"). When set, accounts connect in one
# click with no OAuth and no expiry. This is the ONLY var needed for that path
# (APP_ID/SECRET/BASE_URL/ENCRYPTION_KEY are only for the OAuth route).
META_SYSTEM_TOKEN=
