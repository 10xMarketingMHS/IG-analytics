# Base URL of the Echo Node/Express API (see ../server). Leave it as /api: the
# dev server passes /api on to the API on :4000 (vite.config.ts), so each
# address you open keeps its own sign-in (superadmin.localhost:3000,
# admin.localhost:3000 and editor.localhost:3000 can be three people at once).
# Pointing it straight at http://localhost:4000/api makes them all share one.
VITE_API_URL=/api
